# Copy to .env and adjust as needed.
# Do NOT commit real secrets, API keys, or production credentials.

# SQLite database file (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# HTTP port for the Express API (Render sets PORT automatically)
PORT=3001

# Allowed frontend origin for CORS (local Vite, or your Render URL if split deploy)
CLIENT_ORIGIN="http://localhost:5173"

# Directory for uploaded files (UUID filenames; not committed)
UPLOAD_DIR="uploads"

# Max upload size in bytes (10 MB)
MAX_FILE_SIZE_BYTES=10485760

# Optional: only needed if UI is hosted on a different domain than the API
# VITE_API_URL is a client build-time var — set it in the client build if splitting services
